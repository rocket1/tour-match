# Claude parses prompts and ranks results. Without it the server falls back to keyword matching.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5

# GuruWalk affiliate MCP key (https://github.com/guruwalk/affiliates-mcp)
GURUWALK_API_KEY=

# Viator Partner API key, affiliate Basic access (https://partnerresources.viator.com/travel-commerce/affiliate/)
VIATOR_API_KEY=
# Use https://api.sandbox.viator.com/partner for sandbox keys
# VIATOR_BASE_URL=https://api.viator.com/partner

# Sample catalog shown when no real provider returns results. Set to "off" to disable.
# DEMO_CATALOG=on
PORT=8787

# --- Partners & advertisers -------------------------------------------------
# Bearer token for the /admin API (approve partners, manage ad campaigns). Admin is off when unset.
ADMIN_TOKEN=
# DEV ONLY: lets partner endpoints point at localhost/private IPs so you can test locally.
# ALLOW_LOCAL_PARTNER_URLS=true
# Set when running behind a trusted reverse proxy so rate limits use X-Forwarded-For.
# TRUST_PROXY=true
# Where partners.json, campaigns.json and advertiser-inquiries.json live (default: server/data).
# DATA_DIR=

# --- Advertiser billing (Stripe) ------------------------------------------------
# Test keys from https://dashboard.stripe.com/test/apikeys. Billing is off (ads launch unbilled) when unset.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Price per click in cents (default 60)
# AD_CPC_CENTS=60
